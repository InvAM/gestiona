# ===== Gestiona · producción =====
# Copia a .env.production y completa. Nunca subas .env.production al repositorio.

GESTIONA_DOMAIN=gestiona.tu-empresa.com
FRONTEND_URL=https://gestiona.tu-empresa.com
ALLOWED_HOSTS=gestiona.tu-empresa.com,backend,localhost
CSRF_TRUSTED_ORIGINS=https://gestiona.tu-empresa.com

# Genera con: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=
POSTGRES_PASSWORD=

TIME_ZONE=America/Lima
WEB_WORKERS=2

# Quién puede crear cuenta sola (vacío = solo por invitación del admin)
ALLOWED_SIGNUP_DOMAINS=
PASSWORD_LOGIN_ENABLED=true

# SSO (opcional). Callback: https://<dominio>/accounts/google/login/callback/
SSO_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback: https://<dominio>/accounts/microsoft/login/callback/
SSO_MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations

# SSO con cualquier proveedor OpenID Connect (Okta, Keycloak, Authentik, Entra ID, Auth0...)
# Callback: https://<dominio>/accounts/oidc/login/callback/
SSO_OIDC_ENABLED=false
OIDC_NAME=SSO de la empresa
OIDC_SERVER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Webhooks de automatización hacia IPs internas (por defecto bloqueado)
AUTOMATION_WEBHOOK_ALLOW_PRIVATE=false
# Permite importar desde Jira en red interna/IP privada; dejar en false salvo Jira Server on-prem
IMPORTS_ALLOW_PRIVATE=false
# Días que se conserva el registro de auditoría
AUDIT_RETENTION_DAYS=365

# Asistente de IA (opcional). Sin clave, las funciones de IA no aparecen.
# Al usarlas se envía el texto de la incidencia a la API de Anthropic.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low

# Email SMTP (invitaciones, notificaciones, recuperar contraseña)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.tu-proveedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Gestiona <gestiona@tu-empresa.com>

MAX_ATTACHMENT_MB=50

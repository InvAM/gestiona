# ===== Gestiona =====
DEBUG=true
SECRET_KEY=dev-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://gestiona:gestiona@localhost:5433/gestiona
REDIS_URL=redis://localhost:6379/0
TIME_ZONE=America/Lima

# Registro: dominios de correo que pueden crear cuenta (vacío = solo por invitación)
ALLOWED_SIGNUP_DOMAINS=
PASSWORD_LOGIN_ENABLED=true

# SSO
SSO_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations

# Email (dev: Mailpit en http://localhost:8025)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Gestiona <no-reply@gestiona.local>

# Adjuntos (por defecto disco local; S3 opcional)
USE_S3=false
MAX_ATTACHMENT_MB=50

# Frontend -> backend (usado por Next.js rewrites)
BACKEND_INTERNAL_URL=http://localhost:8010

# Dev: ejecuta tareas (notificaciones/emails) sin worker. En producción: false
CELERY_TASK_ALWAYS_EAGER=true
